RET = SOURCE / "outputs" / "phase2c_return_price_layer.parquet"

HOLD_START = pd.Timestamp("2025-01-02")
LIVE_START = pd.Timestamp("2026-09-04")
UA = (
    "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
    "AppleWebKit/537.36 Chrome/153 Safari/537.36 "
    "AlphaEngineForwardNAV/4.2"
)

sys.path.insert(0, str(V13 / "src"))
